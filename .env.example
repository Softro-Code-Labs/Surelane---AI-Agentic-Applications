# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# The same names are used as Vercel environment variables and GitHub Actions secrets.

# ── Required, in both Vercel and GitHub ─────────────────────────────────────
# Supabase > Connect > Transaction pooler (port 6543). Not the direct connection.
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres
# 32+ random characters. Encrypts your CV. If you lose this, re-upload your CV.
APP_SECRET=
# Optional. Supabase's CA certificate, so the database connection is fully verified.
DATABASE_CA_CERT=

# ── Vercel only ─────────────────────────────────────────────────────────────
# Asked for once, when you create your account. Stops a stranger claiming the app.
SETUP_CODE=
# Shared with the timing service.
CRON_SECRET=
# Lets Search now start the worker straight away.
GITHUB_DISPATCH_TOKEN=
# owner/repository, for example your-name/surelane
GITHUB_REPO=
# Set to ollama or gemini to queue AI versions of cover letters and summaries.
AI_PROVIDER=

# ── Email ───────────────────────────────────────────────────────────────────
# The address the app runs at, for links in emails, for example https://your-app.vercel.app
APP_URL=
# Resend > API Keys. Sending access is enough.
RESEND_API_KEY=
# Leave empty to use Resend's test sender, which only reaches the address on your
# Resend account. After verifying a domain: Surelane <alerts@yourdomain.com>
EMAIL_FROM=

# ── Optional job sources ────────────────────────────────────────────────────
# Gives Himalayas its own rate limit. It works without one.
HIMALAYAS_API_KEY=
# App name approved by ReliefWeb (apidoc.reliefweb.int/parameters#appname). Turns on NGO and UN jobs.
RELIEFWEB_APPNAME=

# ── Optional AI settings (defaults shown) ───────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
# Jobs given AI summaries per search: 20 with Gemini, 12 with Ollama when empty.
AI_MAX_JOBS_PER_RUN=
AI_TIME_BUDGET_SECONDS=420
# Free tier: Google may use what you send to improve its products.
# Contact details are removed first, but your CV content is still sent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Rarely needed ───────────────────────────────────────────────────────────
# Database connections per process (default 3).
DB_POOL_MAX=
# Set to 1 only to sign in over plain http in a production build (not recommended).
INSECURE_COOKIES=
